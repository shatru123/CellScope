@page "/security"

<div style="margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:0.75rem;">
    <div>
        <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">
            🛡️ 3GPP Cryptographic Security & 5G-AKA Analysis
        </h1>
        <p style="font-size:0.875rem;color:var(--text-secondary);">
            Interactive cryptanalysis and verification workbench for AES-128, MILENAGE (TS 35.206), 5G-AKA (TS 33.501), and Key Derivation Functions
        </p>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent-cyan);font-weight:700;">
            3GPP Rel-17/18 Security
        </span>
        <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-weight:700;">
            FIPS-197 AES-128
        </span>
    </div>
</div>

<!-- Tab Navigation Bar -->
<div class="mobile-scroll-tabs" style="display:flex;gap:0.4rem;border-bottom:1px solid var(--border-color);padding-bottom:0.75rem;margin-bottom:1.25rem;overflow-x:auto;white-space:nowrap;">
    <button type="button" class="btn btn-sm @(activeTab == "aes" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "aes")">
        🔑 AES-128 Analyzer
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "aka" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "aka")">
        📶 5G-AKA Flow Simulator
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "milenage" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "milenage")">
        ⚙️ MILENAGE Suite (f1–f5*)
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "hierarchy" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "hierarchy")">
        🌳 5G Key Hierarchy
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "kdf" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "kdf")">
        🧮 5G KDF Playground
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "sequence" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "sequence")">
        🔄 Sequence Diagram
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "testvectors" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "testvectors")">
        ✅ Test Vector Verifier
    </button>
    <button type="button" class="btn btn-sm @(activeTab == "specs" ? "btn-primary" : "btn-outline")"
            style="font-size:0.775rem;font-weight:700;padding:5px 11px;"
            @onclick="@(() => activeTab = "specs")">
        📖 3GPP Specification Guide
    </button>
</div>

<!-- Tab Content Views -->
@if (activeTab == "aes")
{
    <CellScope.Web.Components.Security.AesAnalyzer />
}
else if (activeTab == "aka")
{
    <CellScope.Web.Components.Security.FiveGAkaAnalyzer />
}
else if (activeTab == "milenage")
{
    <CellScope.Web.Components.Security.MilenageAnalyzer />
}
else if (activeTab == "hierarchy")
{
    <CellScope.Web.Components.Security.KeyHierarchyVisualizer />
}
else if (activeTab == "kdf")
{
    <CellScope.Web.Components.Security.KdfCalculator />
}
else if (activeTab == "sequence")
{
    <CellScope.Web.Components.Security.AuthFlowSequenceDiagram />
}
else if (activeTab == "testvectors")
{
    <CellScope.Web.Components.Security.TestVectorVerifier />
}
else if (activeTab == "specs")
{
    <!-- 3GPP Specification Reference Guide -->
    <div style="display:flex;flex-direction:column;gap:1.25rem;">
        <div class="noc-card">
            <div class="noc-card-header">
                <div>
                    <span class="noc-card-title">📖 Official 3GPP & NIST Cryptographic Specifications Index</span>
                    <span style="font-size:0.75rem;color:var(--text-muted);display:block;margin-top:2px;">
                        Clause-by-clause architectural mapping for 5G-AKA, MILENAGE, AES-128, and KDF algorithms
                    </span>
                </div>
            </div>

            <div class="noc-table-container">
                <table class="noc-table">
                    <thead>
                        <tr>
                            <th>Specification</th>
                            <th>Release / Version</th>
                            <th>Key Clauses</th>
                            <th>Cryptographic Subject / Scope</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 33.501</strong></td>
                            <td>Rel-15 to Rel-18</td>
                            <td>Clause 6.1.3, Annex A, Annex B</td>
                            <td>
                                <strong>5G Security Architecture:</strong> 5G-AKA mutual authentication, subscriber privacy (SUCI/SUPI), KDF definitions, and complete key derivation tree ($K \rightarrow K_{AUSF} \rightarrow K_{SEAF} \rightarrow K_{AMF} \rightarrow K_{gNB}$).
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 35.205</strong></td>
                            <td>Rel-4 to Rel-18</td>
                            <td>Clauses 1–5</td>
                            <td>
                                <strong>MILENAGE General:</strong> Architectural requirements for authentication and key generation functions $f_1, f_1^*, f_2, f_3, f_4, f_5, f_5^*$.
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 35.206</strong></td>
                            <td>Rel-4 to Rel-18</td>
                            <td>Clause 4.1</td>
                            <td>
                                <strong>MILENAGE Algorithm Specification:</strong> Mathematical definition of Rijndael AES block encryption, additive constants $c_1 \dots c_5$, and cyclic rotation offsets $r_1 \dots r_5$.
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 35.207</strong></td>
                            <td>Rel-4 to Rel-18</td>
                            <td>Clauses 3–4</td>
                            <td>
                                <strong>MILENAGE Implementor's Test Data:</strong> Official conformance test vectors and intermediate calculation traces for validation.
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 35.208</strong></td>
                            <td>Rel-4 to Rel-18</td>
                            <td>Clauses 4.1–4.6</td>
                            <td>
                                <strong>MILENAGE Design Conformance Test Sets:</strong> Sets 1 to 6 test vectors used in CellScope's automated test suite.
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 33.220</strong></td>
                            <td>Rel-6 to Rel-18</td>
                            <td>Annex B</td>
                            <td>
                                <strong>Generic Key Derivation Function (KDF):</strong> HMAC-SHA-256 string $S = FC \parallel P_0 \parallel L_0 \dots$ parameter concatenation scheme.
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">NIST FIPS-197</strong></td>
                            <td>Federal Standard</td>
                            <td>Clauses 5.1–5.3, App B & C</td>
                            <td>
                                <strong>Advanced Encryption Standard (AES):</strong> 128-bit symmetric block cipher, SubBytes, ShiftRows, MixColumns, AddRoundKey, and Key Schedule.
                            </td>
                        </tr>
                        <tr>
                            <td><strong style="color:var(--accent-cyan);">3GPP TS 24.501</strong></td>
                            <td>Rel-15 to Rel-18</td>
                            <td>Clauses 8.2.1, 8.2.25, 8.2.26</td>
                            <td>
                                <strong>Non-Access-Stratum (NAS) Protocol:</strong> NAS Authentication Request/Response, Security Mode Command, and Security Mode Complete encoding.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Security Model Architectural Note -->
        <div class="noc-card" style="border-left:4px solid #10b981;background:rgba(16,185,129,0.06);">
            <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.4rem;">
                <span style="font-size:1.3rem;">🔒</span>
                <strong style="font-size:0.95rem;color:#10b981;">3GPP Over-the-Air Privacy & Hardware Boundaries</strong>
            </div>
            <p style="font-size:0.8rem;color:var(--text-secondary);line-height:1.5;margin:0;">
                Under 3GPP specifications, the subscriber master secret $K$ is permanently embedded in the tamper-resistant hardware USIM card and the operator ARPF/UDM Hardware Security Module (HSM). The over-the-air radio interface is cryptographically shielded by AES-128 (128-NEA2/128-NIA2), preventing rogue sniffing of subscriber calls or keys.
            </p>
        </div>
    </div>
}

@code {
    private string activeTab = "aes";
}
