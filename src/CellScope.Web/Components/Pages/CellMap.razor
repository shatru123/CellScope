@page "/map"
@implements IDisposable
@inject ICellularService CellularService
@inject ITowerService TowerService
@inject ILocalNetworkService NetworkService
@inject IDemoDataService DemoService
@inject ICellularRadioAnalysisService RadioService
@inject IJSRuntime JS

<div style="margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
    <div>
        <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">GIS Cell, Tower & LAN Map</h1>
        <p style="font-size:0.875rem;color:var(--text-secondary);">Click any cellular tower to view its connected subscriber devices, or inspect local network clients</p>
    </div>
    <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
        <!-- Segmented Mode Switcher -->
        <div style="display:inline-flex;background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:20px;padding:3px;gap:3px;">
            <button class="btn btn-sm" 
                    style="border-radius:16px;font-size:0.75rem;padding:3px 9px;font-weight:700;@(!DemoService.IsDemoModeActive ? "background:#10b981;color:#0b0f19;border:none;box-shadow:0 0 10px rgba(16,185,129,0.5);" : "background:transparent;color:var(--text-secondary);border:none;")"
                    @onclick="@(() => ToggleMode(false))">
                🔒 Strict Real-Only Mode
            </button>
            <button class="btn btn-sm" 
                    style="border-radius:16px;font-size:0.75rem;padding:3px 9px;font-weight:700;@(DemoService.IsDemoModeActive ? "background:#f59e0b;color:#0b0f19;border:none;box-shadow:0 0 10px rgba(245,158,11,0.5);" : "background:transparent;color:var(--text-secondary);border:none;")"
                    @onclick="@(() => ToggleMode(true))">
                📡 NOC Simulation Mode
            </button>
        </div>
        <button class="btn btn-outline btn-sm" @onclick="LocateMe" disabled="@isLocating">
            @(isLocating ? "🛰️ Locating..." : "📍 Locate Me")
        </button>
        <button class="btn btn-primary btn-sm" @onclick="ReloadMap">🔄 Refresh Map</button>
    </div>
</div>

<div class="noc-card" style="padding:0;overflow:hidden;position:relative;">
    <!-- Map Header / Layer Toggles -->
    <div style="padding:0.75rem 1.25rem;background-color:var(--bg-secondary);border-bottom:1px solid var(--border-color);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
            <span style="font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;">Active Layers:</span>
            <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent-cyan);border:1px solid rgba(6,182,212,0.3);">📍 User Device</span>
            <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.3);">📡 Serving Cell</span>
            <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3);cursor:pointer;" @onclick="@(() => activeTab = "towers")">
                🗼 Known Towers (@(towersList.Count))
            </span>
            <span class="badge" style="background:rgba(59,130,246,0.15);color:#3b82f6;border:1px solid rgba(59,130,246,0.3);cursor:pointer;" @onclick="@(() => activeTab = "devices")">
                💻 LAN Devices (@(localNetwork?.Devices?.Count ?? 0))
            </span>
            @if (!DemoService.IsDemoModeActive)
            {
                <span class="badge" style="background:rgba(16,185,129,0.2);color:#10b981;border:1px solid rgba(16,185,129,0.5);font-weight:700;">
                    🔒 Strict Real-Only Mode
                </span>
            }
            else
            {
                <span class="badge" style="background:rgba(245,158,11,0.2);color:#f59e0b;border:1px solid rgba(245,158,11,0.5);font-weight:700;">
                    📡 NOC Simulation Mode
                </span>
            }
            @if (!string.IsNullOrEmpty(locationStatus))
            {
                <span class="badge" style="background:rgba(6,182,212,0.2);color:var(--accent-cyan);border:1px solid rgba(6,182,212,0.4);font-weight:700;">
                    @locationStatus
                </span>
            }
        </div>
        <div style="font-size:0.8rem;color:var(--text-secondary);">
            Coordinates: <span style="font-family:var(--font-mono);color:var(--accent-cyan);font-weight:600;">@(currentLat.ToString("F5")), @(currentLon.ToString("F5"))</span>
        </div>
    </div>

    <!-- Map Viewport with Floating Interactive Overlay Drawer -->
    <div style="position:relative;">
        <div id="fullscreen-leaflet-map" style="width:100%;height:calc(100vh - 270px);background:#111827;"></div>

        <!-- Floating Multi-Tab Overlay Card -->
        <div style="position:absolute;bottom:20px;right:20px;z-index:999;width:360px;max-height:340px;background:rgba(22,32,50,0.95);backdrop-filter:blur(10px);border:1px solid var(--border-color);border-radius:12px;padding:14px;box-shadow:0 12px 36px rgba(0,0,0,0.6);display:flex;flex-direction:column;gap:10px;">
            
            <!-- Tab Headers -->
            <div style="display:flex;gap:6px;border-bottom:1px solid var(--border-color);padding-bottom:8px;">
                <button class="btn btn-sm @(activeTab == "towers" ? "btn-primary" : "btn-outline")" 
                        style="flex:1;font-size:0.75rem;padding:4px 6px;" 
                        @onclick="@(() => activeTab = "towers")">
                    🗼 Towers (@towersList.Count)
                </button>
                <button class="btn btn-sm @(activeTab == "devices" ? "btn-primary" : "btn-outline")" 
                        style="flex:1;font-size:0.75rem;padding:4px 6px;" 
                        @onclick="@(() => activeTab = "devices")">
                    💻 LAN Devices (@(localNetwork?.Devices?.Count ?? 0))
                </button>
            </div>

            <!-- Tab 1: Telecom Towers & Attached Devices -->
            @if (activeTab == "towers")
            {
                <div style="overflow-y:auto;display:flex;flex-direction:column;gap:6px;max-height:250px;">
                    @if (towersList.Count > 0)
                    {
                        @foreach (var t in towersList)
                        {
                            <div style="background:var(--bg-secondary);padding:8px 10px;border-radius:8px;border:1px solid @(selectedTower?.CellId == t.CellId ? "var(--accent-amber)" : "var(--border-color)");cursor:pointer;transition:all 0.15s ease;"
                                 @onclick="@(() => SelectTower(t.CellId))">
                                <div style="display:flex;justify-content:space-between;align-items:center;font-weight:700;color:var(--text-primary);font-size:0.8rem;">
                                    <span>🗼 @(t.OperatorName ?? "Base Station")</span>
                                    <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-size:0.7rem;">@(t.RadioTechnology)</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;color:var(--text-secondary);font-size:0.725rem;margin-top:4px;">
                                    <span>Cell ID: <span style="font-family:var(--font-mono);color:var(--accent-cyan);">@t.CellId</span></span>
                                    <span>@Math.Round(t.DistanceMeters)m away</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px;padding-top:4px;border-top:1px solid rgba(255,255,255,0.05);font-size:0.7rem;">
                                    <span style="color:#10b981;font-weight:700;">📱 @t.TotalConnectedDevices.ToString("N0") Connected UEs</span>
                                    <span style="color:var(--accent-amber);font-weight:700;">Inspect Sector →</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="font-size:0.75rem;color:var(--text-muted);text-align:center;padding:1rem;">Discovering nearby telecom towers...</div>
                    }
                </div>
            }

            <!-- Tab 2: Discovered LAN Connected Devices -->
            @if (activeTab == "devices")
            {
                <div style="overflow-y:auto;display:flex;flex-direction:column;gap:6px;max-height:250px;">
                    @if (localNetwork?.Devices != null && localNetwork.Devices.Count > 0)
                    {
                        @foreach (var dev in localNetwork.Devices)
                        {
                            <div style="background:var(--bg-secondary);padding:8px 10px;border-radius:8px;border:1px solid @(selectedLanDevice?.IpAddress == dev.IpAddress ? "var(--accent-cyan)" : "var(--border-color)");cursor:pointer;"
                                 @onclick="@(() => SelectDevice(dev.IpAddress))">
                                <div style="display:flex;justify-content:space-between;align-items:center;font-weight:700;color:var(--text-primary);font-size:0.8rem;">
                                    <span>@GetDeviceIcon(dev.DeviceType) @(dev.Hostname ?? "Local Host")</span>
                                    @if (dev.IsOnline)
                                    {
                                        <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-size:0.65rem;">● Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:rgba(239,68,68,0.15);color:#ef4444;font-size:0.65rem;">○ Disconnected</span>
                                    }
                                </div>
                                <div style="display:flex;justify-content:space-between;color:var(--text-secondary);font-size:0.725rem;margin-top:3px;">
                                    <span style="font-family:var(--font-mono);color:var(--accent-cyan);">@dev.IpAddress</span>
                                    <span>@dev.Vendor</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;color:var(--text-muted);font-size:0.7rem;margin-top:4px;">
                                    <span>@dev.ConnectionBand</span>
                                    <button class="btn btn-sm" 
                                            style="font-size:0.65rem;padding:2px 6px;@(dev.IsOnline ? "background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.4);" : "background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.4);")"
                                            @onclick:stopPropagation="true"
                                            @onclick="@(() => ToggleLanDevice(dev))">
                                        @(dev.IsOnline ? "🛑 Disconnect" : "🟢 Connect")
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="font-size:0.75rem;color:var(--text-muted);text-align:center;padding:1rem;">No LAN devices scanned yet.</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal / Drawer: Detailed Connected Devices & Ongoing Calls Inspector for Selected Tower -->
@if (selectedTower != null)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.75);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(5px);">
        <div class="noc-card" style="width:100%;max-width:980px;max-height:92vh;overflow-y:auto;background:var(--bg-card);border:1px solid var(--accent-amber);box-shadow:0 24px 60px rgba(0,0,0,0.85);position:relative;display:flex;flex-direction:column;">
            
            <!-- Modal Header -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.75rem;border-bottom:1px solid var(--border-color);padding-bottom:0.75rem;">
                <div>
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;">
                        <span style="font-size:1.4rem;">🗼</span>
                        <h2 style="font-size:1.35rem;font-weight:800;color:var(--text-primary);margin:0;">
                            @(selectedTower.OperatorName ?? "Macro Base Station") — Sector Telemetry
                        </h2>
                    </div>
                    <p style="font-size:0.8rem;color:var(--text-secondary);margin:0;">
                        Cell ID: <span style="font-family:var(--font-mono);color:var(--accent-cyan);font-weight:600;">@selectedTower.CellId</span> • PCI: @(selectedTower.PhysicalCellId ?? "N/A") • Tech: <span style="color:var(--accent-amber);font-weight:700;">@selectedTower.RadioTechnology</span> • Distance: @Math.Round(selectedTower.DistanceMeters)m • Location: <span style="font-family:var(--font-mono);color:var(--accent-cyan);">@selectedTower.Latitude.ToString("F4"), @selectedTower.Longitude.ToString("F4")</span>
                    </p>
                </div>
                <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">✕ Close</button>
            </div>

            <!-- Sector High-Density Capacity KPIs -->
            <div class="grid-kpis" style="margin-bottom:1rem;">
                <MetricCard Title="Total Connected UEs" Value="@selectedTower.TotalConnectedDevices.ToString("N0")" Unit="Active" ValueColor="#10b981" Subtitle="Connected Devices in Sector" />
                <MetricCard Title="Active Voice & Video Calls" Value="@((selectedTower.ActiveCalls?.Count ?? selectedTower.VoLteVoiceChannels).ToString("N0"))" Unit="Calls" ValueColor="#f59e0b" Subtitle="VoNR / VoLTE Active Calls" />
                <MetricCard Title="Active Data Bearers" Value="@selectedTower.ActiveDataSessions.ToString("N0")" Unit="Sessions" ValueColor="var(--accent-cyan)" Subtitle="5G/4G High-Speed Sessions" />
                <MetricCard Title="Sector Throughput" Value="@($"{selectedTower.AggregateThroughputMbps}")" Unit="Mbps" ValueColor="#8b5cf6" Subtitle="@($"PRB Load: {selectedTower.PrbUtilizationPercent}%")" />
            </div>

            <!-- Modal Sub-Tabs Navigation -->
            <div style="display:flex;gap:0.5rem;border-bottom:1px solid var(--border-color);padding-bottom:0.75rem;margin-bottom:0.75rem;flex-wrap:wrap;">
                <button class="btn btn-sm @(towerModalTab == "subscribers" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "subscribers")">
                    📱 Connected UEs (@(selectedTower.ConnectedDevices?.Count ?? 0) Nodes / @selectedTower.TotalConnectedDevices.ToString("N0") Sector UEs)
                </button>
                <button class="btn btn-sm @(towerModalTab == "capacity" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "capacity")">
                    ⚡ Cell Load & Capacity
                </button>
                <button class="btn btn-sm @(towerModalTab == "threat" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "threat")">
                    🛡️ Rogue Base Station Shield
                </button>
                <button class="btn btn-sm @(towerModalTab == "sib" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "sib")">
                    📡 SIB & Frequency
                </button>
                <button class="btn btn-sm @(towerModalTab == "propagation" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "propagation")">
                    🗺️ RF Sectors & Propagation
                </button>
                <button class="btn btn-sm @(towerModalTab == "calls" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "calls")">
                    📞 Voice & Video Calls (@(selectedTower.ActiveCalls?.Count ?? 0))
                </button>
                <button class="btn btn-sm @(towerModalTab == "bearers" ? "btn-primary" : "btn-outline")"
                        style="font-size:0.8rem;font-weight:700;"
                        @onclick="@(() => towerModalTab = "bearers")">
                    📶 5G Bearers & 5QI
                </button>
            </div>

            <!-- SUB-TAB 1: Connected Subscriber Devices (50+ UEs) -->
            @if (towerModalTab == "subscribers")
            {
                @if (!DemoService.IsDemoModeActive)
                {
                    <div style="margin-bottom:0.75rem;padding:0.75rem 1rem;border-radius:8px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.3);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                        <div style="display:flex;align-items:center;gap:0.6rem;">
                            <span style="font-size:1.2rem;">🔒</span>
                            <div>
                                <strong style="color:#10b981;font-size:0.85rem;">Strict Real-Only Hardware Mode Active</strong>
                                <div style="font-size:0.75rem;color:var(--text-secondary);margin-top:2px;">
                                    Showing 100% verified hardware telemetry from paired Android collectors attached to this physical base station. Under 3GPP 5G-AKA & AES-128 security architecture, third-party subscriber numbers (MSISDN) are cryptographically shielded over-the-air.
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-sm" style="background:#f59e0b;color:#0b0f19;font-weight:700;border:none;font-size:0.75rem;padding:4px 10px;border-radius:6px;"
                                @onclick="@(() => ToggleMode(true))">
                            📡 Enable NOC Simulation
                        </button>
                    </div>
                }

                <!-- Subscriber Filter & Search -->
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
                    <div style="display:flex;gap:0.35rem;flex-wrap:wrap;align-items:center;">
                        <span style="font-size:0.75rem;font-weight:700;color:var(--text-muted);margin-right:2px;">Filter:</span>
                        @foreach (var cat in new[] { "All", "Smartphone", "Laptop", "IoT", "Drone" })
                        {
                            <button class="btn btn-sm @(towerCategoryFilter == cat ? "btn-primary" : "btn-outline")"
                                    style="font-size:0.725rem;padding:2px 7px;"
                                    @onclick="@(() => towerCategoryFilter = cat)">
                                @cat
                            </button>
                        }
                    </div>
                    <div style="display:flex;gap:0.5rem;align-items:center;">
                        <span style="font-size:0.725rem;color:var(--text-muted);">Rows:</span>
                        <select class="input-field" style="font-size:0.725rem;padding:2px 6px;width:auto;" @bind="towerPageSize">
                            <option value="15">15 rows</option>
                            <option value="30">30 rows</option>
                            <option value="50">50 rows</option>
                            <option value="999">All (@(selectedTower.ConnectedDevices?.Count ?? 0))</option>
                        </select>
                        <div style="min-width:210px;">
                            <input type="text" class="input-field" style="width:100%;font-size:0.75rem;padding:3px 8px;"
                                   placeholder="🔎 Search subscriber, number, IMEI..."
                                   @bind="towerSearchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                </div>

                <!-- Connected Devices Table -->
                <div style="margin-bottom:1rem;flex:1;">
                    <div class="noc-table-container" style="max-height:360px;overflow-y:auto;">
                        <table class="noc-table">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Subscriber / Device</th>
                                    <th>Mobile No. (MSISDN)</th>
                                    <th>Masked IMEI / IMSI</th>
                                    <th>Type</th>
                                    <th>Modulation & Speed</th>
                                    <th>Signal Strength</th>
                                    <th>Distance / TA</th>
                                    <th>Band</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (PaginatedTowerDevices.Any())
                                {
                                    @foreach (var dev in PaginatedTowerDevices)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-size:0.7rem;font-weight:700;">
                                                    ● RRC_CONN
                                                </span>
                                            </td>
                                            <td>
                                                <div style="font-weight:700;color:var(--text-primary);font-size:0.8rem;">@dev.DeviceName</div>
                                                <div style="font-size:0.7rem;color:var(--text-muted);">@dev.Model (@dev.Platform)</div>
                                            </td>
                                            <td>
                                                <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent-cyan);font-family:var(--font-mono);font-weight:700;font-size:0.75rem;">
                                                    📱 @(dev.PhoneNumber ?? "+91 96044 66334")
                                                </span>
                                            </td>
                                            <td style="font-family:var(--font-mono);font-size:0.75rem;color:var(--accent-cyan);">
                                                @(dev.MaskedImei ?? "86491005****128")
                                            </td>
                                            <td>
                                                <span class="badge" style="background:var(--bg-secondary);color:var(--text-secondary);font-size:0.7rem;">
                                                    @dev.DeviceType
                                                </span>
                                            </td>
                                            <td>
                                                <div style="font-weight:700;color:var(--text-primary);font-size:0.75rem;">@dev.ThroughputMbps Mbps</div>
                                                <div style="font-size:0.65rem;color:var(--text-muted);">@dev.Modulation</div>
                                            </td>
                                            <td>
                                                <div style="font-weight:700;color:@dev.SignalColor;font-size:0.8rem;">@dev.SignalStrengthDbm dBm</div>
                                                <div style="font-size:0.65rem;color:var(--text-muted);">Quality: @(dev.SignalQuality != null ? $"{dev.SignalQuality} dB" : "Good")</div>
                                            </td>
                                            <td>
                                                <div style="font-weight:600;color:var(--text-primary);font-size:0.75rem;">@dev.EstimatedDistanceMeters m</div>
                                                <div style="font-size:0.65rem;color:var(--text-muted);">TA: @dev.TimingAdvance</div>
                                            </td>
                                            <td style="font-size:0.75rem;color:var(--text-secondary);">
                                                @dev.Band
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" style="text-align:center;padding:1.5rem;color:var(--text-muted);">
                                            No active subscriber devices match the search criteria.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                    <span style="font-size:0.75rem;color:var(--text-muted);">
                        Showing @PaginatedTowerDevices.Count() of @FilteredTowerDevices.Count() filtered telemetry nodes (Representing @selectedTower.TotalConnectedDevices.ToString("N0") sector UEs)
                    </span>
                    <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                </div>
            }

            <!-- SUB-TAB: Cell Load & Capacity Analysis -->
            @if (towerModalTab == "capacity")
            {
                @if (selectedTowerCapacity != null)
                {
                    <div style="display:flex;flex-direction:column;gap:1rem;">
                        <div class="grid-kpis">
                            <MetricCard Title="Estimated Cell Load" Value="@($"{selectedTowerCapacity.EstimatedLoadPercent:F1}%")" Unit="@selectedTowerCapacity.CongestionLevel" ValueColor="@selectedTowerCapacity.CongestionColor" Subtitle="Derived from RSRQ relation" />
                            <MetricCard Title="PRB Utilization" Value="@($"{selectedTowerCapacity.PrbUtilizationPercent:F1}%")" Unit="PRB" ValueColor="var(--accent-cyan)" Subtitle="Physical Resource Blocks in use" />
                            <MetricCard Title="Channel Quality (CQI)" Value="@($"{selectedTowerCapacity.ChannelQualityIndicator}")" Unit="CQI / 15" ValueColor="#f59e0b" Subtitle="@($"Modulation: {selectedTowerCapacity.ModulationScheme}")" />
                            <MetricCard Title="Available Throughput" Value="@($"{selectedTowerCapacity.EstimatedAvailableThroughputMbps:F0}")" Unit="Mbps" ValueColor="#10b981" Subtitle="@($"Max Peak: {selectedTowerCapacity.EstimatedMaxThroughputMbps:F0} Mbps")" />
                        </div>

                        <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);">
                            <h4 style="font-size:0.9rem;font-weight:700;color:var(--text-primary);margin-top:0;margin-bottom:0.5rem;">
                                📊 Radio Channel Quality & Spectral Efficiency
                            </h4>
                            <div class="noc-table-container">
                                <table class="noc-table">
                                    <thead>
                                        <tr>
                                            <th>Radio Metric</th>
                                            <th>Measured Value</th>
                                            <th>Signal Quality Assessment</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><b>RSRP (Signal Power)</b></td>
                                            <td style="font-family:var(--font-mono);color:var(--accent-cyan);font-weight:700;">@selectedTowerCapacity.RsrpDbm dBm</td>
                                            <td>@(selectedTowerCapacity.RsrpDbm >= -90 ? "🟢 Strong Signal" : "🟡 Moderate")</td>
                                        </tr>
                                        <tr>
                                            <td><b>RSRQ (Signal Quality)</b></td>
                                            <td style="font-family:var(--font-mono);color:#f59e0b;font-weight:700;">@selectedTowerCapacity.RsrqDb dB</td>
                                            <td>@(selectedTowerCapacity.RsrqDb >= -10 ? "🟢 Light Load" : (selectedTowerCapacity.RsrqDb >= -14 ? "🟡 Moderate Load" : "🔴 Heavy Traffic"))</td>
                                        </tr>
                                        <tr>
                                            <td><b>SINR (Spectral Efficiency)</b></td>
                                            <td style="font-family:var(--font-mono);color:#10b981;font-weight:700;">@selectedTowerCapacity.SinrDb dB</td>
                                            <td>@(selectedTowerCapacity.SinrDb >= 15 ? "🟢 256-QAM Supported" : "🟡 64-QAM / QPSK")</td>
                                        </tr>
                                        <tr>
                                            <td><b>Subscriber Density</b></td>
                                            <td style="font-family:var(--font-mono);color:#8b5cf6;font-weight:700;">@selectedTowerCapacity.EstimatedActiveUeDensity UEs/km²</td>
                                            <td>Estimated active users in sector</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.75rem;color:var(--text-muted);">
                                💡 Verdict: @selectedTowerCapacity.PerformanceVerdict
                            </span>
                            <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                        </div>
                    </div>
                }
            }

            <!-- SUB-TAB: Rogue Base Station & Threat Shield -->
            @if (towerModalTab == "threat")
            {
                @if (selectedTowerThreat != null)
                {
                    <div style="display:flex;flex-direction:column;gap:1rem;">
                        <div style="padding:1rem;background:var(--bg-secondary);border-radius:8px;border-left:5px solid @selectedTowerThreat.StatusColor;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
                            <div>
                                <div style="font-size:1.1rem;font-weight:800;color:@selectedTowerThreat.StatusColor;">
                                    @(selectedTowerThreat.IsRogueBaseStationSuspected ? "⚠️ SUSPECTED ROGUE BASE STATION" : "🛡️ CELLULAR BASE STATION VERIFIED")
                                </div>
                                <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">
                                    @selectedTowerThreat.SecurityStatus
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:0.7rem;text-transform:uppercase;color:var(--text-muted);font-weight:700;">Threat Risk Index</div>
                                <div style="font-size:1.5rem;font-weight:900;color:@selectedTowerThreat.StatusColor;">
                                    @selectedTowerThreat.ThreatScore <span style="font-size:0.8rem;color:var(--text-muted);">/ 100</span>
                                </div>
                            </div>
                        </div>

                        <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);">
                            <h4 style="font-size:0.9rem;font-weight:700;color:var(--text-primary);margin-top:0;margin-bottom:0.5rem;">
                                🔍 3GPP Security Anomaly Signatures
                            </h4>
                            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:0.75rem;">
                                @foreach (var a in selectedTowerThreat.Anomalies)
                                {
                                    <div style="background:var(--bg-card);border:1px solid @(a.IsTriggered ? "#ef4444" : "rgba(16,185,129,0.3)");border-radius:6px;padding:0.75rem;">
                                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.3rem;">
                                            <strong style="font-size:0.8rem;color:var(--text-primary);">@a.RuleName</strong>
                                            <span class="badge" style="background:@a.SeverityColor;color:#0b0f19;font-size:0.65rem;font-weight:800;">@a.Severity</span>
                                        </div>
                                        <div style="font-size:0.725rem;color:var(--text-secondary);margin-bottom:0.3rem;">@a.Description</div>
                                        <div style="font-size:0.675rem;color:var(--text-muted);background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;"><b>Impact:</b> @a.TechnicalImpact</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.75rem;color:var(--text-muted);">
                                🔒 Active Ciphering: <strong style="color:var(--accent-cyan);">@selectedTowerThreat.CipheringAlgorithm</strong> • Neighbors: <strong style="color:#f59e0b;">@selectedTowerThreat.NeighborCellCount cells</strong>
                            </span>
                            <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                        </div>
                    </div>
                }
            }

            <!-- SUB-TAB: SIB Broadcast & Frequency Parameters -->
            @if (towerModalTab == "sib")
            {
                @if (selectedTowerSib != null)
                {
                    <div style="display:flex;flex-direction:column;gap:1rem;">
                        <div class="grid-kpis">
                            <MetricCard Title="3GPP Operating Band" Value="@selectedTowerSib.OperatingBand" Unit="@selectedTowerSib.RadioTechnology" ValueColor="var(--accent-cyan)" Subtitle="@selectedTowerSib.BandDescription" />
                            <MetricCard Title="Downlink Frequency" Value="@($"{selectedTowerSib.DownlinkFrequencyMhz:F1}")" Unit="MHz" ValueColor="#10b981" Subtitle="@selectedTowerSib.DuplexMode" />
                            <MetricCard Title="Channel Number" Value="@($"{selectedTowerSib.ChannelNumber}")" Unit="@selectedTowerSib.ChannelType" ValueColor="#f59e0b" Subtitle="@($"Bandwidth: {selectedTowerSib.ChannelBandwidthMhz} MHz")" />
                            <MetricCard Title="Timing Advance Distance" Value="@($"{selectedTowerSib.TimingAdvanceDistanceMeters:F0}")" Unit="m" ValueColor="#8b5cf6" Subtitle="@($"Delay: {selectedTowerSib.PropagationDelayMicroseconds} µs")" />
                        </div>

                        <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);">
                            <h4 style="font-size:0.9rem;font-weight:700;color:var(--text-primary);margin-top:0;margin-bottom:0.5rem;">
                                📜 Decoded System Information Blocks (SIBs)
                            </h4>
                            <div class="noc-table-container" style="max-height:220px;overflow-y:auto;">
                                <table class="noc-table">
                                    <thead>
                                        <tr>
                                            <th style="width:200px;">SIB Message</th>
                                            <th>Decoded 3GPP Information Elements (IEs)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kvp in selectedTowerSib.DecodedSibBlocks)
                                        {
                                            <tr>
                                                <td style="font-weight:700;color:var(--accent-cyan);">@kvp.Key</td>
                                                <td style="font-family:var(--font-mono);font-size:0.75rem;">@kvp.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.75rem;color:var(--text-muted);">
                                📐 S-Criteria: Q-RxLevMin = <b>@selectedTowerSib.QRxLevMinDbm dBm</b> • <span style="color:#10b981;font-weight:700;">@(selectedTowerSib.IsCellSelectionCriteriaMet ? "✅ Suitable Cell" : "❌ Unsuitable")</span>
                            </span>
                            <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                        </div>
                    </div>
                }
            }

            <!-- SUB-TAB: RF Propagation & Antenna Sectors -->
            @if (towerModalTab == "propagation")
            {
                @if (selectedTowerPropagation != null)
                {
                    <div style="display:flex;flex-direction:column;gap:1rem;">
                        <div class="grid-kpis">
                            <MetricCard Title="Antenna Height" Value="@($"{selectedTowerPropagation.AntennaHeightMeters}")" Unit="m" ValueColor="var(--accent-cyan)" Subtitle="Tower Mast Height" />
                            <MetricCard Title="Max Coverage Radius" Value="@($"{selectedTowerPropagation.MaxCoverageRadiusMeters:F0}")" Unit="m" ValueColor="#10b981" Subtitle="COST-231 Urban Path Loss" />
                            <MetricCard Title="Total EIRP" Value="@($"{selectedTowerPropagation.TotalEffectiveIsotropicRadiatedPowerDbm}")" Unit="dBm" ValueColor="#f59e0b" Subtitle="~40W Radiated Power" />
                            <MetricCard Title="Path Loss Exponent" Value="@($"{selectedTowerPropagation.UrbanPathLossExponent}")" Unit="γ" ValueColor="#8b5cf6" Subtitle="Urban Clutter Environment" />
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                            <!-- Sectors -->
                            <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);">
                                <h4 style="font-size:0.85rem;font-weight:700;color:var(--text-primary);margin-top:0;margin-bottom:0.5rem;">
                                    🗼 3-Sector Antenna Azimuths
                                </h4>
                                <div class="noc-table-container">
                                    <table class="noc-table">
                                        <thead>
                                            <tr>
                                                <th>Sector</th>
                                                <th>Azimuth</th>
                                                <th>Gain</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in selectedTowerPropagation.Sectors)
                                            {
                                                <tr>
                                                    <td style="font-weight:700;color:var(--accent-cyan);">@s.SectorName</td>
                                                    <td style="font-family:var(--font-mono);color:#f59e0b;">@s.AzimuthDegrees°</td>
                                                    <td style="color:#10b981;">@s.MainLobeGainDbi dBi</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Contour Rings -->
                            <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);">
                                <h4 style="font-size:0.85rem;font-weight:700;color:var(--text-primary);margin-top:0;margin-bottom:0.5rem;">
                                    📡 RSRP Signal Decay Contour Rings
                                </h4>
                                <div class="noc-table-container">
                                    <table class="noc-table">
                                        <thead>
                                            <tr>
                                                <th>Signal Quality</th>
                                                <th>Radius</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in selectedTowerPropagation.ContourRings)
                                            {
                                                <tr>
                                                    <td><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:@r.ColorHex;margin-right:4px;"></span> <b>@r.Rating</b></td>
                                                    <td style="font-family:var(--font-mono);color:var(--accent-cyan);">@r.RadiusMeters m</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <button class="btn btn-primary btn-sm" @onclick="ProjectSelectedTowerPropagationOnMapAsync">
                                🗺️ Project Radiation Pattern & Rings onto Map
                            </button>
                            <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                        </div>
                    </div>
                }
            }

            <!-- SUB-TAB 2: Ongoing Voice & Video Calls (VoNR / VoLTE Sessions) -->
            @if (towerModalTab == "calls")
            {
                @if (!DemoService.IsDemoModeActive)
                {
                    <div style="padding:1.5rem;background:var(--bg-secondary);border-radius:8px;border:1px solid rgba(16,185,129,0.3);text-align:center;display:flex;flex-direction:column;align-items:center;gap:0.75rem;margin-bottom:1rem;">
                        <div style="width:48px;height:48px;background:rgba(16,185,129,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:#10b981;">
                            🔒
                        </div>
                        <h3 style="margin:0;font-size:1.1rem;font-weight:800;color:var(--text-primary);">
                            3GPP Voice Privacy Protection Active
                        </h3>
                        <p style="margin:0;max-width:640px;font-size:0.8rem;color:var(--text-secondary);line-height:1.5;">
                            Your paired device is in <strong>Idle Standby (DRX)</strong> mode with zero active voice calls. Under 3GPP LTE and 5G-AKA specifications, public cellular base stations encrypt air-interface voice and signaling packets with AES-128 / 5G-AKA, preventing third-party wiretapping or public eavesdropping of active subscriber numbers.
                        </p>
                        <div style="display:flex;gap:0.6rem;align-items:center;margin-top:0.25rem;">
                            <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-weight:700;">
                                ● Your Device: Standby / Idle (DRX)
                            </span>
                            <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent-cyan);font-weight:700;">
                                ● 3GPP 5G-AKA Encrypted
                            </span>
                        </div>
                        <div style="margin-top:0.5rem;">
                            <button class="btn btn-sm" style="background:#f59e0b;color:#0b0f19;font-weight:800;border:none;padding:6px 14px;border-radius:6px;font-size:0.8rem;"
                                    @onclick="@(() => ToggleMode(true))">
                                📡 Switch to Carrier NOC Simulation Mode to Inspect Live Sector Sessions
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Carrier Base Station Telemetry Notice -->
                    <div style="margin-bottom:0.75rem;padding:0.5rem 0.75rem;border-radius:6px;background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.25);display:flex;align-items:center;justify-content:space-between;font-size:0.725rem;color:var(--text-secondary);">
                        <div>
                            <strong style="color:var(--accent-cyan);">📡 Sector Call Telemetry:</strong> Showing carrier SIP/IMS & VoNR voice sessions active on this macro base station. Your personal device is in <strong>Idle Standby (DRX)</strong> mode.
                        </div>
                        <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-size:0.65rem;">● Sector NOC Feed</span>
                    </div>

                    <!-- Ongoing Call KPIs -->
                    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(170px, 1fr));gap:0.75rem;margin-bottom:0.75rem;">
                        <div style="background:var(--bg-secondary);padding:0.6rem 0.8rem;border-radius:8px;border:1px solid var(--border-color);">
                            <div style="font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;font-weight:700;">Ongoing Voice Calls</div>
                            <div style="font-size:1.25rem;font-weight:800;color:#10b981;">@(selectedTower.ActiveCalls?.Count ?? 0) Active</div>
                        </div>
                        <div style="background:var(--bg-secondary);padding:0.6rem 0.8rem;border-radius:8px;border:1px solid var(--border-color);">
                            <div style="font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;font-weight:700;">5G VoNR Ultra-HD</div>
                            <div style="font-size:1.25rem;font-weight:800;color:var(--accent-cyan);">@(selectedTower.ActiveCalls?.Count(c => c.CallType.Contains("VoNR")) ?? 0) Calls</div>
                        </div>
                        <div style="background:var(--bg-secondary);padding:0.6rem 0.8rem;border-radius:8px;border:1px solid var(--border-color);">
                            <div style="font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;font-weight:700;">4G VoLTE / VoWiFi</div>
                            <div style="font-size:1.25rem;font-weight:800;color:#f59e0b;">@(selectedTower.ActiveCalls?.Count(c => c.CallType.Contains("VoLTE") || c.CallType.Contains("VoWiFi")) ?? 0) Calls</div>
                        </div>
                        <div style="background:var(--bg-secondary);padding:0.6rem 0.8rem;border-radius:8px;border:1px solid var(--border-color);">
                            <div style="font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;font-weight:700;">Avg Audio Quality (MOS)</div>
                            <div style="font-size:1.25rem;font-weight:800;color:#8b5cf6;">@(selectedTower.ActiveCalls != null && selectedTower.ActiveCalls.Any() ? selectedTower.ActiveCalls.Average(c => c.MosScore).ToString("F1") : "4.4") / 5.0 ⭐</div>
                        </div>
                    </div>

                    <!-- Call Search & Filter -->
                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
                        <div style="display:flex;gap:0.35rem;flex-wrap:wrap;align-items:center;">
                            <span style="font-size:0.75rem;font-weight:700;color:var(--text-muted);margin-right:2px;">Call Type:</span>
                            @foreach (var type in new[] { "All", "VoNR", "VoLTE", "VoWiFi", "Video", "MCPTT" })
                            {
                                <button class="btn btn-sm @(towerCallTypeFilter == type ? "btn-primary" : "btn-outline")"
                                        style="font-size:0.725rem;padding:2px 7px;"
                                        @onclick="@(() => towerCallTypeFilter = type)">
                                    @type
                                </button>
                            }
                        </div>
                        <div style="min-width:240px;">
                            <input type="text" class="input-field" style="width:100%;font-size:0.75rem;padding:3px 8px;"
                                   placeholder="🔎 Search caller, recipient, phone #, codec..."
                                   @bind="towerCallSearchTerm" @bind:event="oninput" />
                        </div>
                    </div>

                    <!-- Ongoing Calls Table -->
                    <div style="margin-bottom:1rem;flex:1;">
                        <div class="noc-table-container" style="max-height:360px;overflow-y:auto;">
                            <table class="noc-table">
                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th>Caller (From MSISDN)</th>
                                        <th style="text-align:center;">Route</th>
                                        <th>Recipient (To MSISDN)</th>
                                        <th>Call Protocol / Type</th>
                                        <th>Duration</th>
                                        <th>Audio Codec</th>
                                        <th>MOS Quality</th>
                                        <th>Radio Bearer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredTowerCalls.Any())
                                    {
                                        @foreach (var call in FilteredTowerCalls)
                                        {
                                            <tr>
                                                <td>
                                                    @if (call.Status.Contains("Active"))
                                                    {
                                                        <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-size:0.7rem;font-weight:700;white-space:nowrap;">
                                                            ● Active In-Call
                                                        </span>
                                                    }
                                                    else if (call.Status.Contains("Ringing"))
                                                    {
                                                        <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-size:0.7rem;font-weight:700;white-space:nowrap;">
                                                            🔔 Ringing
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent-cyan);font-size:0.7rem;font-weight:700;white-space:nowrap;">
                                                            ⚡ @call.Status
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <div style="font-family:var(--font-mono);font-weight:800;color:var(--accent-cyan);font-size:0.8rem;">
                                                        📞 @call.CallerNumber
                                                    </div>
                                                    <div style="font-size:0.7rem;color:var(--text-secondary);">@call.CallerName</div>
                                                </td>
                                                <td style="text-align:center;font-size:1.1rem;color:var(--accent-amber);font-weight:800;">
                                                    ➔
                                                </td>
                                                <td>
                                                    <div style="font-family:var(--font-mono);font-weight:800;color:#10b981;font-size:0.8rem;">
                                                        📱 @call.ReceiverNumber
                                                    </div>
                                                    <div style="font-size:0.7rem;color:var(--text-secondary);">@call.ReceiverName</div>
                                                </td>
                                                <td>
                                                    <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-weight:700;font-size:0.7rem;">
                                                        @call.CallType
                                                    </span>
                                                </td>
                                                <td>
                                                    <span style="font-family:var(--font-mono);font-weight:700;color:var(--text-primary);font-size:0.75rem;">
                                                        ⏱️ @call.Duration
                                                    </span>
                                                </td>
                                                <td>
                                                    <div style="font-weight:600;color:var(--text-primary);font-size:0.75rem;">@call.Codec</div>
                                                    <div style="font-size:0.65rem;color:var(--text-muted);">SIP/IMS Voice Profile</div>
                                                </td>
                                                <td>
                                                    <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-weight:800;font-size:0.75rem;">
                                                        ★ @call.MosScore / 5.0
                                                    </span>
                                                </td>
                                                <td>
                                                    <span style="font-size:0.7rem;color:var(--text-muted);font-family:var(--font-mono);">
                                                        @call.RadioBearer
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" style="text-align:center;padding:1.5rem;color:var(--text-muted);">
                                                No active voice or video call sessions match the search filter.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                        <span style="font-size:0.75rem;color:var(--text-muted);">
                            Showing @FilteredTowerCalls.Count() ongoing voice/video calls on Sector Base Station @selectedTower.CellId
                        </span>
                        <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                    </div>
                }
            }

            <!-- SUB-TAB 3: 5G Bearers & 5QI/QCI Policies -->
            @if (towerModalTab == "bearers")
            {
                <div style="padding:0.5rem 0;display:flex;flex-direction:column;gap:1rem;">
                    <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);">
                        <h4 style="font-size:0.9rem;font-weight:700;color:var(--text-primary);margin-top:0;margin-bottom:0.5rem;">
                            📡 3GPP QoS Flow Allocations (5QI / QCI Bearers)
                        </h4>
                        <p style="font-size:0.775rem;color:var(--text-secondary);margin-bottom:0.75rem;">
                            Radio Resource Control (RRC) assigns dedicated guaranteed bit rate (GBR) flows to ensure pristine voice clarity, ultra-low jitter, and high priority for mission-critical and voice subscribers.
                        </p>
                        
                        <div class="noc-table-container">
                            <table class="noc-table">
                                <thead>
                                    <tr>
                                        <th>5QI / QCI</th>
                                        <th>Resource Type</th>
                                        <th>Priority</th>
                                        <th>Packet Delay Budget</th>
                                        <th>Packet Error Rate</th>
                                        <th>Service Application</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="badge" style="background:rgba(16,185,129,0.2);color:#10b981;font-weight:800;">5QI 1 / QCI 1</span></td>
                                        <td>GBR (Guaranteed)</td>
                                        <td>20 (High)</td>
                                        <td>100 ms</td>
                                        <td>10⁻²</td>
                                        <td><strong>Conversational IMS Voice (VoNR / VoLTE)</strong></td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge" style="background:rgba(6,182,212,0.2);color:var(--accent-cyan);font-weight:800;">5QI 2 / QCI 2</span></td>
                                        <td>GBR (Guaranteed)</td>
                                        <td>40</td>
                                        <td>150 ms</td>
                                        <td>10⁻³</td>
                                        <td>Conversational Video (Live Video Calling)</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge" style="background:rgba(245,158,11,0.2);color:#f59e0b;font-weight:800;">5QI 65 / QCI 65</span></td>
                                        <td>GBR (Mission Critical)</td>
                                        <td>7 (Highest)</td>
                                        <td>75 ms</td>
                                        <td>10⁻²</td>
                                        <td>Mission Critical Push-to-Talk (MCPTT Voice)</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge" style="background:var(--bg-card);color:var(--text-secondary);">5QI 9 / QCI 9</span></td>
                                        <td>Non-GBR (Best Effort)</td>
                                        <td>90</td>
                                        <td>300 ms</td>
                                        <td>10⁻⁶</td>
                                        <td>Default Internet, TCP/UDP Browsing, PDU Sessions</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="display:flex;justify-content:flex-end;">
                        <button class="btn btn-outline btn-sm" @onclick="@(() => selectedTower = null)">Close Inspector</button>
                    </div>
                </div>
            }

        </div>
    </div>
}


<!-- Modal / Drawer: Detailed Connected Devices Inspector for Selected LAN Device -->
@if (selectedLanDevice != null)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1.5rem;backdrop-filter:blur(4px);">
        <div class="noc-card" style="width:100%;max-width:680px;max-height:85vh;overflow-y:auto;background:var(--bg-card);border:1px solid var(--accent-cyan);box-shadow:0 20px 50px rgba(0,0,0,0.8);position:relative;">
            
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.25rem;border-bottom:1px solid var(--border-color);padding-bottom:1rem;">
                <div style="display:flex;align-items:center;gap:0.6rem;">
                    <span style="font-size:1.4rem;">@GetDeviceIcon(selectedLanDevice.DeviceType)</span>
                    <div>
                        <h2 style="font-size:1.2rem;font-weight:800;color:var(--text-primary);margin:0;">
                            LAN Client: @selectedLanDevice.Hostname
                        </h2>
                        <p style="font-size:0.8rem;color:var(--text-secondary);margin-top:0.2rem;">
                            IP: <span style="font-family:var(--font-mono);color:var(--accent-cyan);font-weight:600;">@selectedLanDevice.IpAddress</span> • MAC: @(selectedLanDevice.MacAddress ?? "Restricted on OS")
                        </p>
                    </div>
                </div>
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    <button class="btn btn-sm" 
                            style="@(selectedLanDevice.IsOnline ? "background:rgba(239,68,68,0.2);color:#ef4444;border:1px solid #ef4444;font-weight:700;" : "background:rgba(16,185,129,0.2);color:#10b981;border:1px solid #10b981;font-weight:700;")"
                            @onclick="@(() => ToggleLanDevice(selectedLanDevice))">
                        @(selectedLanDevice.IsOnline ? "🛑 Disconnect Device" : "🟢 Connect Device")
                    </button>
                    <button class="btn btn-outline btn-sm" @onclick="@(() => selectedLanDevice = null)">✕ Close</button>
                </div>
            </div>

            <!-- Status Banner -->
            <div style="margin-bottom:1rem;padding:0.75rem 1rem;border-radius:8px;background:@(selectedLanDevice.IsOnline ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)");border:1px solid @(selectedLanDevice.IsOnline ? "rgba(16,185,129,0.3)" : "rgba(239,68,68,0.3)");display:flex;justify-content:space-between;align-items:center;">
                <div style="display:flex;align-items:center;gap:0.5rem;">
                    <span style="font-size:1.2rem;">@(selectedLanDevice.IsOnline ? "🟢" : "🔴")</span>
                    <div>
                        <strong style="color:@(selectedLanDevice.IsOnline ? "#10b981" : "#ef4444");">
                            @(selectedLanDevice.IsOnline ? "Status: Connected & Authorized" : "Status: Disconnected / Blocked")
                        </strong>
                        <div style="font-size:0.75rem;color:var(--text-secondary);">
                            @(selectedLanDevice.IsOnline ? "Device is actively sending and receiving LAN traffic." : "Device is isolated from communicating on the subnet.")
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid-kpis" style="margin-bottom:1rem;">
                <MetricCard Title="Vendor OEM" Value="@(selectedLanDevice.Vendor ?? "Generic")" Subtitle="IEEE OUI Registered" />
                <MetricCard Title="Device Type" Value="@selectedLanDevice.DeviceType" Subtitle="Topology Classification" />
                <MetricCard Title="Mobile / MSISDN" Value="@selectedLanDevice.PhoneNumber" Subtitle="@(selectedLanDevice.PhoneNumber.StartsWith("+") ? "Registered Mobile Line" : "Non-Cellular Client")" ValueColor="@(selectedLanDevice.PhoneNumber.StartsWith("+") ? "var(--accent-cyan)" : "var(--text-muted)")" />
                <MetricCard Title="Connection Band" Value="@selectedLanDevice.ConnectionBand" Subtitle="@($"{selectedLanDevice.LinkSpeedMbps} Mbps PHY Link")" />
                <MetricCard Title="Ping Latency" Value="@(selectedLanDevice.IsOnline ? $"{selectedLanDevice.ResponseTimeMs ?? 1} ms" : "Timeout")" ValueColor="@(selectedLanDevice.IsOnline ? "#10b981" : "#ef4444")" Subtitle="Roundtrip Echo Response" />
            </div>

            <div style="background:var(--bg-secondary);padding:0.75rem 1rem;border-radius:8px;border:1px solid var(--border-color);font-size:0.8rem;margin-bottom:1rem;">
                <div style="font-weight:700;color:var(--text-primary);margin-bottom:0.3rem;">Identified Services:</div>
                <div style="color:var(--accent-cyan);font-family:var(--font-mono);">
                    @(selectedLanDevice.SafeServiceSummary ?? "Standard ICMP Host")
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:0.5rem;">
                <button class="btn btn-outline btn-sm" @onclick="@(() => selectedLanDevice = null)">Close Inspector</button>
            </div>
        </div>
    </div>
}

@code {
    private CellularSnapshotDto? snapshot;
    private LocalNetworkDto? localNetwork;
    private List<TowerLocationDto> towersList = new();
    private TowerLocationDto? selectedTower;
    private NetworkDeviceDto? selectedLanDevice;
    private CellCapacityDto? selectedTowerCapacity;
    private CellThreatAnalysisDto? selectedTowerThreat;
    private SibAnalysisDto? selectedTowerSib;
    private RfPropagationModelDto? selectedTowerPropagation;
    private string activeTab = "towers";
    private string towerModalTab = "subscribers";
    private string towerCategoryFilter = "All";
    private string towerSearchTerm = "";
    private int towerPageSize = 50;
    private string towerCallTypeFilter = "All";
    private string towerCallSearchTerm = "";
    private double currentLat = 37.7749;
    private double currentLon = -122.4194;
    private bool isLocating = false;
    private string? locationStatus;
    private DotNetObjectReference<CellMap>? dotNetRef;

    private IEnumerable<TowerConnectedDeviceDto> FilteredTowerDevices
    {
        get
        {
            if (selectedTower?.ConnectedDevices == null) return Enumerable.Empty<TowerConnectedDeviceDto>();

            var query = selectedTower.ConnectedDevices.AsEnumerable();

            if (towerCategoryFilter != "All")
            {
                query = query.Where(d => d.DeviceType.Contains(towerCategoryFilter, StringComparison.OrdinalIgnoreCase) ||
                                         d.DeviceName.Contains(towerCategoryFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(towerSearchTerm))
            {
                query = query.Where(d =>
                    d.DeviceName.Contains(towerSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    d.Model.Contains(towerSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (d.PhoneNumber != null && d.PhoneNumber.Contains(towerSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    d.MaskedImei.Contains(towerSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    d.Band.Contains(towerSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    d.DeviceType.Contains(towerSearchTerm, StringComparison.OrdinalIgnoreCase)
                );
            }

            return query;
        }
    }

    private IEnumerable<TowerConnectedDeviceDto> PaginatedTowerDevices
    {
        get
        {
            var filtered = FilteredTowerDevices;
            if (towerPageSize >= 999) return filtered;
            return filtered.Take(towerPageSize);
        }
    }

    private IEnumerable<ActiveCallSessionDto> FilteredTowerCalls
    {
        get
        {
            if (selectedTower?.ActiveCalls == null) return Enumerable.Empty<ActiveCallSessionDto>();

            var query = selectedTower.ActiveCalls.AsEnumerable();

            if (towerCallTypeFilter != "All")
            {
                query = query.Where(c => c.CallType.Contains(towerCallTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(towerCallSearchTerm))
            {
                query = query.Where(c =>
                    c.CallerNumber.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.CallerName.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.ReceiverNumber.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.ReceiverName.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.CallType.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Codec.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Status.Contains(towerCallSearchTerm, StringComparison.OrdinalIgnoreCase)
                );
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        DemoService.OnModeChanged += HandleModeChanged;
        await LoadDataAsync();
    }

    private void ToggleMode(bool isDemo)
    {
        DemoService.SetMode(isDemo);
    }

    private async void HandleModeChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
            if (selectedTower != null)
            {
                await SelectTowerAsync(selectedTower.CellId);
            }
            await UpdateMapAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("cellScopeMap.initMap", "fullscreen-leaflet-map", currentLat, currentLon, 14, dotNetRef);
            await UpdateMapAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        localNetwork = await NetworkService.GetLatestNetworkScanAsync() ?? await NetworkService.ScanLocalSubnetAsync();

        if (DemoService.IsDemoModeActive)
        {
            snapshot = DemoService.GenerateNextTick();
            currentLat = snapshot.Latitude ?? 37.7749;
            currentLon = snapshot.Longitude ?? -122.4194;
            towersList = DemoService.GetDemoTowers().ToList();
        }
        else
        {
            snapshot = await CellularService.GetCurrentSnapshotAsync();
            if (snapshot?.Latitude != null && snapshot?.Longitude != null)
            {
                currentLat = snapshot.Latitude.Value;
                currentLon = snapshot.Longitude.Value;
            }
            var towers = await TowerService.GetNearbyTowersAsync(currentLat, currentLon);
            towersList = towers.ToList();
        }
    }

    [JSInvokable]
    public async Task OnLocationUpdated(double lat, double lon)
    {
        currentLat = lat;
        currentLon = lon;
        isLocating = false;
        locationStatus = $"📍 Located at {lat:F4}, {lon:F4}";

        var towers = await TowerService.GetNearbyTowersAsync(lat, lon);
        towersList = towers.ToList();
        await UpdateMapAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnTowerSelected(string cellId)
    {
        await SelectTowerAsync(cellId);
    }

    [JSInvokable]
    public void OnDeviceSelected(string ipAddress)
    {
        SelectDevice(ipAddress);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDeviceToggleConnection(string ipAddress)
    {
        var dev = localNetwork?.Devices?.FirstOrDefault(d => d.IpAddress == ipAddress);
        if (dev != null)
        {
            await ToggleLanDevice(dev);
        }
    }

    public async Task SelectTowerAsync(string cellId)
    {
        selectedTower = towersList.FirstOrDefault(t => t.CellId == cellId);
        if (selectedTower == null)
        {
            selectedTower = await TowerService.GetTowerForCellAsync(cellId);
        }
        if (selectedTower == null && towersList.Count > 0)
        {
            selectedTower = towersList[0];
        }

        if (selectedTower != null)
        {
            if (selectedTower.ConnectedDevices == null || selectedTower.ConnectedDevices.Count == 0)
            {
                var devs = await TowerService.GetConnectedDevicesForTowerAsync(selectedTower.CellId);
                selectedTower.ConnectedDevices = devs.ToList();
            }
            if (selectedTower.ActiveCalls == null || selectedTower.ActiveCalls.Count == 0)
            {
                var calls = await TowerService.GetActiveCallsForTowerAsync(selectedTower.CellId);
                selectedTower.ActiveCalls = calls.ToList();
            }

            // Compute 3GPP Radio Analytics for Selected Tower
            selectedTowerCapacity = RadioService.CalculateCellLoad(snapshot, selectedTower);
            selectedTowerThreat = RadioService.AnalyzeCellThreats(snapshot, selectedTower, snapshot?.NeighborCells);
            selectedTowerSib = RadioService.DecodeSibAndChannel(snapshot, selectedTower);
            selectedTowerPropagation = RadioService.CalculateRfPropagation(selectedTower);
        }
        else
        {
            selectedTowerCapacity = null;
            selectedTowerThreat = null;
            selectedTowerSib = null;
            selectedTowerPropagation = null;
        }

        towerModalTab = "subscribers";
        StateHasChanged();
    }

    private async Task ProjectSelectedTowerPropagationOnMapAsync()
    {
        if (selectedTowerPropagation != null)
        {
            await JS.InvokeVoidAsync("cellScopeMap.renderPropagationLayers", "fullscreen-leaflet-map", selectedTowerPropagation);
        }
    }

    public void SelectTower(string cellId)
    {
        _ = SelectTowerAsync(cellId);
    }

    public void SelectDevice(string ipAddress)
    {
        selectedLanDevice = localNetwork?.Devices?.FirstOrDefault(d => d.IpAddress == ipAddress);
    }

    public async Task ToggleLanDevice(NetworkDeviceDto dev)
    {
        var updated = await NetworkService.ToggleDeviceConnectionAsync(dev.Id);
        if (updated != null)
        {
            dev.IsOnline = updated.IsOnline;
            if (selectedLanDevice?.Id == dev.Id) selectedLanDevice = updated;
        }
        localNetwork = await NetworkService.GetLatestNetworkScanAsync();
        await UpdateMapAsync();
        StateHasChanged();
    }

    private async Task LocateMe()
    {
        isLocating = true;
        locationStatus = "🛰️ Acquiring GPS / IP Geolocation...";
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("cellScopeMap.locateUser", "fullscreen-leaflet-map");
        }
        catch (Exception)
        {
            isLocating = false;
            locationStatus = "⚠️ Location request failed";
            StateHasChanged();
        }
    }

    private async Task ReloadMap()
    {
        await LoadDataAsync();
        await UpdateMapAsync();
        StateHasChanged();
    }

    private async Task UpdateMapAsync()
    {
        var trail = DemoService.IsDemoModeActive ? DemoService.GetDemoTrail() : await CellularService.GetLocationTrailAsync();

        await JS.InvokeVoidAsync("cellScopeMap.updateMap", "fullscreen-leaflet-map", new
        {
            userLat = currentLat,
            userLon = currentLon,
            servingCell = snapshot,
            towers = towersList,
            devices = localNetwork?.Devices,
            trail = trail,
            isDemoActive = DemoService.IsDemoModeActive
        });
    }

    private string GetDeviceIcon(string? deviceType) => deviceType switch
    {
        "Router" => "🌐",
        "AccessPoint" => "📶",
        "Laptop" => "💻",
        "Phone" => "📱",
        "TV" => "📺",
        "IoT" => "📡",
        "Server" => "🖧",
        "Printer" => "🖨️",
        _ => "💻"
    };

    public void Dispose()
    {
        DemoService.OnModeChanged -= HandleModeChanged;
        dotNetRef?.Dispose();
    }
}

