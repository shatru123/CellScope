    private async Task ExportFile(string format)
    {
        showExportMenu = false;
        var trail = DemoService.IsDemoModeActive ? DemoService.GetDemoTrail() : await CellularService.GetLocationTrailAsync();
        string content = format switch
        {
            "kml" => GisService.GenerateKml(towersList, snapshot, trail),
            "geojson" => GisService.GenerateGeoJson(towersList, snapshot, trail),
            "csv" => GisService.GenerateCsv(towersList),
            _ => ""
        };
        string mimeType = format switch
        {
            "kml" => "application/vnd.google-earth.kml+xml",
            "geojson" => "application/geo+json",
            "csv" => "text/csv",
            _ => "text/plain"
        };
        string filename = $"cellscope_export_{DateTime.UtcNow:yyyyMMdd_HHmmss}.{format}";
        await JS.InvokeVoidAsync("cellScopeGis.downloadFile", filename, content, mimeType);
    }

    private async Task LoadDataAsync()
    {
        try
        {
            localNetwork = await NetworkService.GetLatestNetworkScanAsync() ?? await NetworkService.ScanLocalSubnetAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CellMap] Local network load notice: {ex.Message}");
            localNetwork = null;
        }

        try
        {
            if (DemoService.IsDemoModeActive)
            {
                snapshot = DemoService.GenerateNextTick();
                currentLat = snapshot.Latitude ?? 37.7749;
                currentLon = snapshot.Longitude ?? -122.4194;
                currentCenterLat = currentLat;
                currentCenterLon = currentLon;
                await LoadTowersForAreaAsync(currentCenterLat, currentCenterLon, currentRadiusMeters);
            }
            else
            {
                snapshot = await CellularService.GetCurrentSnapshotAsync();
                if (snapshot?.Latitude != null && snapshot?.Longitude != null)
                {
                    currentLat = snapshot.Latitude.Value;
                    currentLon = snapshot.Longitude.Value;
                    currentCenterLat = currentLat;
                    currentCenterLon = currentLon;
                }
                await LoadTowersForAreaAsync(currentCenterLat, currentCenterLon, currentRadiusMeters);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CellMap] Cellular snapshot load notice: {ex.Message}");
            snapshot = DemoService.GenerateNextTick();
            await LoadTowersForAreaAsync(currentCenterLat, currentCenterLon, currentRadiusMeters);
        }
    }

    private async Task LoadTowersForAreaAsync(double lat, double lon, double radiusMeters)
    {
        try
        {
            if (DemoService.IsDemoModeActive)
            {
                towersList = DemoService.GetDemoTowers(lat, lon, radiusMeters).ToList();
            }
            else
            {
                var towers = await TowerService.GetNearbyTowersAsync(lat, lon, radiusMeters);
                towersList = towers.ToList();
            }

            for (int i = 0; i < towersList.Count; i++)
            {
                var t = towersList[i];
                var (area, street, city, postal) = DemoDataService.ResolveGeographicAddress(t.Latitude, t.Longitude, i, t.RadioTechnology);
                t.Area = area;
                t.StreetAddress = street;
                t.City = city;
                t.PostalCode = postal;
            }

            if (showOsmTowers)
            {
                try
                {
                    var (minLat, maxLat, minLon, maxLon) = GeodesyUtils.GetBoundingBox(lat, lon, radiusMeters);
                    var osmTowers = await OsmService.GetOsmTowersInBoundsAsync(minLat, minLon, maxLat, maxLon);
                    if (osmTowers.Count > 0)
                    {
                        var existingIds = towersList.Select(t => t.CellId).ToHashSet();
                        foreach (var ot in osmTowers)
                        {
                            if (!existingIds.Contains(ot.CellId))
                            {
                                ot.DistanceMeters = GeodesyUtils.CalculateDistanceMeters(lat, lon, ot.Latitude, ot.Longitude);
                                towersList.Add(ot);
                            }
                        }
                        towersList = towersList.OrderBy(t => t.DistanceMeters).ToList();
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CellMap] LoadTowersForArea notice: {ex.Message}");
            towersList = DemoService.GetDemoTowers(lat, lon, radiusMeters).ToList();
            for (int i = 0; i < towersList.Count; i++)
            {
                var t = towersList[i];
                var (area, street, city, postal) = DemoDataService.ResolveGeographicAddress(t.Latitude, t.Longitude, i, t.RadioTechnology);
                t.Area = area;
                t.StreetAddress = street;
                t.City = city;
                t.PostalCode = postal;
            }
        }
    }

    [JSInvokable]
    public async Task OnMapViewChanged(double lat, double lon, double radiusMeters, MapBoundsDto? bounds)
    {
        currentCenterLat = lat;
        currentCenterLon = lon;

        if (selectedTower != null && GeodesyUtils.CalculateDistanceMeters(lat, lon, selectedTower.Latitude, selectedTower.Longitude) > radiusMeters)
        {
            selectedTower = null;
        }

        if (radiusFilterSelection == "Auto")
        {
            currentRadiusMeters = radiusMeters;
        }
        else if (double.TryParse(radiusFilterSelection.Replace("km", "").Trim(), out double km))
        {
            currentRadiusMeters = km * 1000.0;
        }

        var closest = regionSubAreas
            .SelectMany(kv => kv.Value.Select(a => new { City = kv.Key, Area = a.Name, Distance = Math.Sqrt(Math.Pow(lat - a.Lat, 2) + Math.Pow(lon - a.Lon, 2)) }))
            .OrderBy(x => x.Distance)
            .FirstOrDefault();

        if (closest != null && closest.Distance < 0.20)
        {
            selectedPresetCity = closest.City;
            selectedSubAreaName = closest.Area;
        }

        if (autoFetchOnMapMove)
        {
            await LoadTowersForAreaAsync(currentCenterLat, currentCenterLon, currentRadiusMeters);
            await UpdateMapAsync();
            StateHasChanged();
        }
    }

    private async Task JumpToPresetCity(string cityName)
    {
        if (regionSubAreas.TryGetValue(cityName, out var areas) && areas.Count > 0)
        {
            selectedTower = null;
            selectedPresetCity = cityName;
            var firstArea = areas[0];
            selectedSubAreaName = firstArea.Name;
            currentCenterLat = firstArea.Lat;
            currentCenterLon = firstArea.Lon;
            await JS.InvokeVoidAsync("cellScopeMap.flyToLocation", "fullscreen-leaflet-map", firstArea.Lat, firstArea.Lon, 14);
            await LoadTowersForAreaAsync(firstArea.Lat, firstArea.Lon, currentRadiusMeters);
            await UpdateMapAsync();
            StateHasChanged();
        }
    }

    private async Task JumpToSubArea(string areaName)
    {
        var area = CurrentRegionAreas.FirstOrDefault(a => a.Name == areaName);
        if (area != null)
        {
            selectedTower = null;
            selectedSubAreaName = area.Name;
            currentCenterLat = area.Lat;
            currentCenterLon = area.Lon;
            await JS.InvokeVoidAsync("cellScopeMap.flyToLocation", "fullscreen-leaflet-map", area.Lat, area.Lon, 14);
            await LoadTowersForAreaAsync(area.Lat, area.Lon, currentRadiusMeters);
            await UpdateMapAsync();
            StateHasChanged();
        }
    }

    private async Task JumpToCustomCoordinates()
    {
        if (string.IsNullOrWhiteSpace(coordinatesSearchInput)) return;

        var parts = coordinatesSearchInput.Split(new[] { ',', ' ', ';' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && double.TryParse(parts[0], out double lat) && double.TryParse(parts[1], out double lon))
        {
            selectedTower = null;
            currentCenterLat = lat;
            currentCenterLon = lon;
            await JS.InvokeVoidAsync("cellScopeMap.flyToLocation", "fullscreen-leaflet-map", lat, lon, 14);
            await LoadTowersForAreaAsync(lat, lon, currentRadiusMeters);
            await UpdateMapAsync();
            StateHasChanged();
        }
    }

