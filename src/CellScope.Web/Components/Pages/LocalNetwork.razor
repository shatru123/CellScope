@page "/network"
@inject ILocalNetworkService NetworkService
@inject IDemoDataService DemoService

<div style="margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:0.75rem;">
    <div>
        <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">My Local Network & Connected Devices</h1>
        <p style="font-size:0.875rem;color:var(--text-secondary);">Complete LAN client topology, device discovery, and interactive connection control</p>
    </div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <a href="/map" class="btn btn-outline btn-sm">🗺️ View on Map</a>
        <button class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.4);" @onclick="ConnectAllDevices">
            🔌 Connect All
        </button>
        <button class="btn btn-sm" style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.4);" @onclick="DisconnectAllDevices">
            🛑 Disconnect All
        </button>
        <button class="btn btn-primary btn-sm" @onclick="ScanNetwork" disabled="@isScanning">
            @(isScanning ? "Scanning LAN..." : "🔍 Scan Local Subnet")
        </button>
    </div>
</div>

<!-- LAN Adapter Link Status Notice -->
<div class="noc-card" style="margin-bottom:1.5rem;background:@(isAdapterActive ? "rgba(6,182,212,0.05)" : "rgba(239,68,68,0.08)");border-color:@(isAdapterActive ? "rgba(6,182,212,0.3)" : "rgba(239,68,68,0.4)");">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
        <div style="display:flex;gap:0.75rem;align-items:center;">
            <span style="font-size:1.4rem;">@(isAdapterActive ? "🛡️" : "⚠️")</span>
            <div>
                <div style="font-weight:700;font-size:0.9rem;color:@(isAdapterActive ? "var(--accent-cyan)" : "#ef4444");">
                    @(isAdapterActive ? "Local Network Interface: Connected & Active" : "Local Network Interface: Disconnected / Offline")
                </div>
                <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:0.2rem;">
                    @(isAdapterActive 
                        ? "Safe discovery is active across the local subnet. You can individually connect, isolate, or disconnect devices below." 
                        : "LAN interface link is suspended. Reconnect interface adapter to resume active traffic.")
                </div>
            </div>
        </div>
        <button class="btn btn-sm @(isAdapterActive ? "btn-outline" : "btn-primary")" @onclick="ToggleAdapterLink">
            @(isAdapterActive ? "Disable Adapter Link" : "Enable Adapter Link")
        </button>
    </div>
</div>

<!-- Subnet KPI Cards -->
<div class="grid-kpis">
    <MetricCard Title="Local Subnet" Value="@(network?.Subnet ?? "192.168.31.0/24")" Subtitle="Class C Private Network" />
    <MetricCard Title="Default Gateway" Value="@(network?.GatewayIp ?? "192.168.31.1")" Subtitle="Primary Router / NAT" />
    <MetricCard Title="Connected Devices" Value="@((network?.ConnectedCount ?? 0).ToString())" Unit="Online" ValueColor="#10b981" Subtitle="Active Communicating Hosts" />
    <MetricCard Title="Disconnected / Blocked" Value="@((network?.DisconnectedCount ?? 0).ToString())" Unit="Offline" ValueColor="#ef4444" Subtitle="Isolated Endpoints" />
</div>

<!-- Filter & Search Bar -->
<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-bottom:1rem;">
    <!-- Category Pills -->
    <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
        @foreach (var category in new[] { "All", "Router", "AccessPoint", "Laptop", "Phone", "TV", "IoT", "Server", "Printer" })
        {
            <button class="btn btn-sm @(selectedCategory == category ? "btn-primary" : "btn-outline")"
                    @onclick="@(() => selectedCategory = category)">
                @category
            </button>
        }
    </div>

    <!-- Status & Search Filters -->
    <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <select class="input-field" style="font-size:0.8rem;padding:0.4rem 0.6rem;" @bind="statusFilter">
            <option value="All">All Statuses</option>
            <option value="Online">🟢 Connected Only</option>
            <option value="Offline">🛑 Disconnected Only</option>
        </select>
        <div style="min-width:220px;">
            <input type="text" class="input-field" style="width:100%;font-size:0.8rem;padding:0.4rem 0.75rem;" 
                   placeholder="🔎 Search by hostname, IP, vendor, service..." 
                   @bind="searchTerm" @bind:event="oninput" />
        </div>
    </div>
</div>

<!-- Discovered Devices Table -->
<div class="noc-card">
    <div class="noc-card-header">
        <span class="noc-card-title">Discovered Connected Devices Inventory (@FilteredDevices.Count() Endpoints)</span>
        <span style="font-size:0.75rem;color:var(--text-muted);">Last Scanned: @(network?.ScannedAt.ToString("HH:mm:ss") ?? "Just now")</span>
    </div>

    <div class="noc-table-container">
        <table class="noc-table">
            <thead>
                <tr>
                    <th>Connection State</th>
                    <th>Device Hostname</th>
                    <th>IP Address</th>
                    <th>Mobile / MSISDN</th>
                    <th>MAC Address</th>
                    <th>Vendor / Manufacturer</th>
                    <th>Type</th>
                    <th>Band / Speed</th>
                    <th>Ping Latency</th>
                    <th>Identified Services</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredDevices.Any())
                {
                    @foreach (var dev in FilteredDevices)
                    {
                        <tr style="cursor:pointer;" @onclick="@(() => selectedDevice = dev)">
                            <td>
                                @if (dev.IsOnline)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-weight:700;">
                                        ● Connected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#ef4444;font-weight:700;">
                                        ○ Disconnected
                                    </span>
                                }
                            </td>
                            <td>
                                <div style="font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:0.4rem;">
                                    <span>@GetDeviceIcon(dev.DeviceType)</span>
                                    <span>@(dev.Hostname ?? "Local Client")</span>
                                </div>
                            </td>
                            <td>
                                <div style="font-family:var(--font-mono);font-weight:600;color:var(--accent-cyan);">
                                    @dev.IpAddress
                                </div>
                                <div style="font-size:0.7rem;color:var(--text-muted);">@dev.IpAssignment</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(dev.PhoneNumber) && dev.PhoneNumber.StartsWith("+"))
                                {
                                    <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent-cyan);font-family:var(--font-mono);font-weight:700;font-size:0.75rem;">
                                        📱 @dev.PhoneNumber
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:0.75rem;">
                                        @(dev.PhoneNumber ?? "N/A")
                                    </span>
                                }
                            </td>
                            <td style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);">
                                @(dev.MacAddress ?? "Restricted on OS")
                            </td>
                            <td style="font-weight:500;">
                                @dev.Vendor
                            </td>
                            <td>
                                <span class="badge" style="background:var(--bg-secondary);color:var(--text-secondary);">
                                    @dev.DeviceType
                                </span>
                            </td>
                            <td style="font-size:0.75rem;color:var(--text-secondary);">
                                @dev.ConnectionBand
                            </td>
                            <td style="font-size:0.8rem;color:var(--text-secondary);">
                                @(dev.IsOnline ? (dev.ResponseTimeMs != null ? $"{dev.ResponseTimeMs} ms" : "1 ms") : "Timed Out")
                            </td>
                            <td style="font-size:0.75rem;color:var(--text-muted);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(dev.SafeServiceSummary ?? "ICMP Host")
                            </td>
                            <td style="text-align:center;" @onclick:stopPropagation="true">
                                @if (dev.IsOnline)
                                {
                                    <button class="btn btn-sm" 
                                            style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.4);font-size:0.75rem;padding:3px 8px;"
                                            @onclick="@(() => ToggleDeviceConnection(dev))">
                                        🛑 Disconnect
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm" 
                                            style="background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.4);font-size:0.75rem;padding:3px 8px;"
                                            @onclick="@(() => ToggleDeviceConnection(dev))">
                                        🟢 Connect
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" style="text-align:center;padding:2.5rem;color:var(--text-muted);">
                            No network devices match the active filter criteria. Click "Scan Local Subnet" to discover clients.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Detailed Device Inspector Modal / Bottom Card -->
@if (selectedDevice != null)
{
    <div style="margin-top:1.5rem;" class="noc-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;border-bottom:1px solid var(--border-color);padding-bottom:0.75rem;">
            <div style="display:flex;align-items:center;gap:0.6rem;">
                <span style="font-size:1.4rem;">@GetDeviceIcon(selectedDevice.DeviceType)</span>
                <div>
                    <h3 style="font-size:1.15rem;font-weight:800;color:var(--text-primary);margin:0;">
                        Device Inspector: @selectedDevice.Hostname
                    </h3>
                    <span style="font-size:0.75rem;color:var(--text-muted);">
                        Vendor: @selectedDevice.Vendor • Category: @selectedDevice.DeviceType
                    </span>
                </div>
            </div>
            <div style="display:flex;gap:0.5rem;align-items:center;">
                @if (selectedDevice.IsOnline)
                {
                    <button class="btn btn-sm" style="background:rgba(239,68,68,0.2);color:#ef4444;border:1px solid #ef4444;font-weight:700;"
                            @onclick="@(() => ToggleDeviceConnection(selectedDevice))">
                        🛑 Disconnect Device
                    </button>
                }
                else
                {
                    <button class="btn btn-sm" style="background:rgba(16,185,129,0.2);color:#10b981;border:1px solid #10b981;font-weight:700;"
                            @onclick="@(() => ToggleDeviceConnection(selectedDevice))">
                        🟢 Connect Device
                    </button>
                }
                <button class="btn btn-outline btn-sm" @onclick="@(() => selectedDevice = null)">✕ Close</button>
            </div>
        </div>

        <!-- Connection State Banner -->
        <div style="margin-bottom:1rem;padding:0.75rem 1rem;border-radius:8px;background:@(selectedDevice.IsOnline ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)");border:1px solid @(selectedDevice.IsOnline ? "rgba(16,185,129,0.3)" : "rgba(239,68,68,0.3)");display:flex;justify-content:space-between;align-items:center;">
            <div style="display:flex;align-items:center;gap:0.5rem;">
                <span style="font-size:1.2rem;">@(selectedDevice.IsOnline ? "🟢" : "🔴")</span>
                <div>
                    <strong style="color:@(selectedDevice.IsOnline ? "#10b981" : "#ef4444");">
                        @(selectedDevice.IsOnline ? "Status: Connected & Authorized" : "Status: Disconnected / Blocked")
                    </strong>
                    <div style="font-size:0.75rem;color:var(--text-secondary);">
                        @(selectedDevice.IsOnline ? "Device is actively communicating on the LAN subnet." : "Device is disconnected or isolated from communicating on the network.")
                    </div>
                </div>
            </div>
        </div>

        <div class="grid-kpis" style="margin-bottom:1rem;">
            <MetricCard Title="IP Address" Value="@selectedDevice.IpAddress" Subtitle="@selectedDevice.IpAssignment" />
            <MetricCard Title="Mobile Number / MSISDN" Value="@selectedDevice.PhoneNumber" Subtitle="@(selectedDevice.PhoneNumber.StartsWith("+") ? "Registered Mobile Line" : "Non-Cellular Client")" ValueColor="@(selectedDevice.PhoneNumber.StartsWith("+") ? "var(--accent-cyan)" : "var(--text-muted)")" />
            <MetricCard Title="Hardware MAC" Value="@(selectedDevice.MacAddress ?? "Restricted on OS")" Subtitle="Physical Layer Address" />
            <MetricCard Title="Connection Band" Value="@selectedDevice.ConnectionBand" Subtitle="@($"{selectedDevice.LinkSpeedMbps} Mbps PHY Link")" />
            <MetricCard Title="Ping Roundtrip" Value="@(selectedDevice.IsOnline ? $"{selectedDevice.ResponseTimeMs ?? 1} ms" : "Timeout")" ValueColor="@(selectedDevice.IsOnline ? "#10b981" : "#ef4444")" Subtitle="ICMP Response Latency" />
        </div>

        <div style="background:var(--bg-secondary);padding:1rem;border-radius:8px;border:1px solid var(--border-color);font-size:0.8rem;">
            <div style="font-weight:700;color:var(--text-primary);margin-bottom:0.4rem;">Identified Services & Protocols:</div>
            <div style="color:var(--accent-cyan);font-family:var(--font-mono);">
                @(selectedDevice.SafeServiceSummary ?? "Standard ICMP / mDNS Host")
            </div>
        </div>
    </div>
}

@code {
    private LocalNetworkDto? network;
    private NetworkDeviceDto? selectedDevice;
    private string selectedCategory = "All";
    private string statusFilter = "All";
    private string searchTerm = "";
    private bool isScanning = false;
    private bool isAdapterActive = true;

    private IEnumerable<NetworkDeviceDto> FilteredDevices
    {
        get
        {
            if (network?.Devices == null) return Enumerable.Empty<NetworkDeviceDto>();

            var query = network.Devices.AsEnumerable();

            if (selectedCategory != "All")
            {
                query = query.Where(d => string.Equals(d.DeviceType, selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (statusFilter == "Online")
            {
                query = query.Where(d => d.IsOnline);
            }
            else if (statusFilter == "Offline")
            {
                query = query.Where(d => !d.IsOnline);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(d =>
                    (d.Hostname != null && d.Hostname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    d.IpAddress.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (d.PhoneNumber != null && d.PhoneNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (d.Vendor != null && d.Vendor.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (d.SafeServiceSummary != null && d.SafeServiceSummary.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    d.ConnectionBand.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                );
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNetworkDataAsync();
    }

    private async Task LoadNetworkDataAsync()
    {
        network = await NetworkService.GetLatestNetworkScanAsync() ?? await NetworkService.ScanLocalSubnetAsync();
        isAdapterActive = network.IsAdapterConnected;
    }

    private async Task ScanNetwork()
    {
        isScanning = true;
        StateHasChanged();

        network = await NetworkService.ScanLocalSubnetAsync();
        if (network != null)
        {
            isAdapterActive = network.IsAdapterConnected;
        }

        isScanning = false;
        StateHasChanged();
    }

    private async Task ToggleDeviceConnection(NetworkDeviceDto dev)
    {
        var updated = await NetworkService.ToggleDeviceConnectionAsync(dev.Id);
        if (updated != null)
        {
            dev.IsOnline = updated.IsOnline;
            if (selectedDevice?.Id == dev.Id) selectedDevice = updated;
        }
        network = await NetworkService.GetLatestNetworkScanAsync();
        StateHasChanged();
    }

    private async Task ConnectAllDevices()
    {
        network = await NetworkService.SetAllDevicesConnectionAsync(true);
        if (selectedDevice != null)
        {
            selectedDevice.IsOnline = true;
        }
        StateHasChanged();
    }

    private async Task DisconnectAllDevices()
    {
        network = await NetworkService.SetAllDevicesConnectionAsync(false);
        if (selectedDevice != null)
        {
            selectedDevice.IsOnline = false;
        }
        StateHasChanged();
    }

    private async Task ToggleAdapterLink()
    {
        network = await NetworkService.ToggleAdapterConnectionAsync();
        if (network != null)
        {
            isAdapterActive = network.IsAdapterConnected;
        }
        StateHasChanged();
    }

    private string GetDeviceIcon(string? deviceType) => deviceType switch
    {
        "Router" => "🌐",
        "AccessPoint" => "📶",
        "Laptop" => "💻",
        "Phone" => "📱",
        "TV" => "📺",
        "IoT" => "📡",
        "Server" => "🖧",
        "Printer" => "🖨️",
        _ => "💻"
    };
}
