@code {
    private string activeTab = "load";
    private bool isDemoMode = true;

    private CellCapacityDto? capacity;
    private CellThreatAnalysisDto? threat;
    private SibAnalysisDto? sib;
    private RfPropagationModelDto? propagation;
    private Private5gCoreStatusDto? p5gStatus;
    private IReadOnlyList<Private5gSubscriberDto> p5gSubscribers = new List<Private5gSubscriberDto>();

    protected override async Task OnInitializedAsync()
    {
        isDemoMode = DemoService.IsDemoModeActive;
        DemoService.OnModeChanged += HandleModeChanged;
        await LoadAllAnalysisDataAsync();
    }

    private void HandleModeChanged()
    {
        isDemoMode = DemoService.IsDemoModeActive;
        InvokeAsync(async () =>
        {
            await LoadAllAnalysisDataAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAllDataAsync()
    {
        await LoadAllAnalysisDataAsync();
    }

    private async Task LoadAllAnalysisDataAsync()
    {
        try
        {
            var snapshot = await CellularService.GetCurrentSnapshotAsync();
            var neighbors = await CellularService.GetCurrentNeighborsAsync();
            TowerLocationDto? tower = null;

            if (snapshot != null && !string.IsNullOrEmpty(snapshot.CellId))
            {
                tower = await TowerService.GetTowerForCellAsync(snapshot.CellId, snapshot.RadioTechnology);
            }

            if (tower == null)
            {
                var nearby = await TowerService.GetNearbyTowersAsync(37.7749, -122.4194, 5000);
                tower = nearby.FirstOrDefault() ?? new TowerLocationDto
                {
                    CellId = "410-01-382910",
                    RadioTechnology = "5G NR",
                    OperatorName = "AT&T 5G",
                    Latitude = 37.7749,
                    Longitude = -122.4194,
                    RangeMeters = 2400
                };
            }

            capacity = RadioService.CalculateCellLoad(snapshot, tower);
            threat = RadioService.AnalyzeCellThreats(snapshot, tower, neighbors);
            sib = RadioService.DecodeSibAndChannel(snapshot, tower);
            propagation = RadioService.CalculateRfPropagation(tower);
            p5gStatus = await Private5gService.GetCoreStatusAsync();
            p5gSubscribers = await Private5gService.GetConnectedSubscribersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading radio analysis data: {ex.Message}");
        }
    }

    public void Dispose()
    {
        DemoService.OnModeChanged -= HandleModeChanged;
    }
}
